<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.MODFLOW" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/modflow_primary</item>
        <item name="colorPrimaryDark">@color/modflow_primary_dark</item>
        <item name="colorAccent">@color/modflow_accent</item>
        <item name="android:windowBackground">@color/modflow_background</item>
        <item name="android:statusBarColor">@color/modflow_primary_dark</item>
        <item name="android:navigationBarColor">@color/modflow_surface</item>
    </style>

    <!-- Dashboard Theme -->
    <style name="Theme.MODFLOW.Dashboard" parent="Theme.MODFLOW">
        <item name="android:windowBackground">@color/modflow_background</item>
    </style>

    <!-- Card Style -->
    <style name="MODFLOW.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/modflow_card_background</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Button Style -->
    <style name="MODFLOW.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/modflow_primary</item>
        <item name="android:textColor">@color/modflow_text_on_primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="MODFLOW.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/modflow_primary</item>
        <item name="android:textColor">@color/modflow_primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Text Styles -->
    <style name="MODFLOW.Text.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/modflow_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MODFLOW.Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/modflow_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MODFLOW.Text.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/modflow_text_secondary</item>
    </style>

    <style name="MODFLOW.Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/modflow_text_primary</item>
    </style>

    <style name="MODFLOW.Text.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/modflow_text_secondary</item>
    </style>

    <!-- Input Field Style -->
    <style name="MODFLOW.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/modflow_primary</item>
        <item name="hintTextColor">@color/modflow_primary</item>
    </style>

    <!-- Toolbar Style -->
    <style name="MODFLOW.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/modflow_surface</item>
        <item name="titleTextColor">@color/modflow_text_primary</item>
        <item name="subtitleTextColor">@color/modflow_text_secondary</item>
    </style>

    <!-- Navigation Rail Style -->
    <style name="MODFLOW.NavigationRail" parent="Widget.Material3.NavigationRailView">
        <item name="backgroundTint">@color/modflow_nav_background</item>
        <item name="itemIconTint">@color/modflow_text_secondary</item>
        <item name="itemTextColor">@color/modflow_text_secondary</item>
    </style>
</resources>
