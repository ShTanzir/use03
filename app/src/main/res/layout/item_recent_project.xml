<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:cardBackgroundColor="@color/modflow_card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <TextView
            android:id="@+id/textProjectName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/MODFLOW.Text.Title"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/textPackageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/MODFLOW.Text.Body"
            android:textColor="@color/modflow_text_secondary"
            android:layout_marginTop="@dimen/spacing_xs"
            android:maxLines="1"
            android:ellipsize="end"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_small">

            <TextView
                android:id="@+id/textLastModified"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/MODFLOW.Text.Caption"/>

            <TextView
                android:id="@+id/textBuildStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/MODFLOW.Text.Caption"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
