<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/modflow_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/modflow_primary"
            app:navigationIcon="@drawable/ic_back"
            app:title="Project Details"
            app:titleTextColor="@color/modflow_text_on_primary"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                android:layout_marginBottom="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:id="@+id/textProjectName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/MODFLOW.Text.Headline"/>

                    <TextView
                        android:id="@+id/textPackageName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/MODFLOW.Text.Body"
                        android:textColor="@color/modflow_text_secondary"
                        android:layout_marginTop="@dimen/spacing_small"/>

                    <TextView
                        android:id="@+id/textVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/MODFLOW.Text.Caption"
                        android:layout_marginTop="@dimen/spacing_xs"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/modflow_divider"
                        android:layout_marginVertical="@dimen/spacing_medium"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        text="APK Path"
                        style="@style/MODFLOW.Text.Caption"/>

                    <TextView
                        android:id="@+id/textApkPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/MODFLOW.Text.Body"
                        android:ellipsize="middle"
                        android:singleLine="true"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Actions"
                style="@style/MODFLOW.Text.Title"
                android:layout_marginBottom="@dimen/spacing_small"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnalyzer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="APK Analyzer"
                style="@style/MODFLOW.Button.Primary"
                android:layout_marginBottom="@dimen/spacing_small"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExplorer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="APK Explorer"
                style="@style/MODFLOW.Button.Secondary"
                android:layout_marginBottom="@dimen/spacing_small"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWorkflow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Workflow Builder"
                style="@style/MODFLOW.Button.Secondary"
                android:layout_marginBottom="@dimen/spacing_small"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuild"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Build Project"
                style="@style/MODFLOW.Button.Primary"
                android:layout_marginBottom="@dimen/spacing_medium"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/textBuildCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/MODFLOW.Text.Headline"
                        android:textColor="@color/modflow_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        text="Builds"
                        style="@style/MODFLOW.Text.Caption"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/textPatchCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/MODFLOW.Text.Headline"
                        android:textColor="@color/modflow_accent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        text="Patches"
                        style="@style/MODFLOW.Text.Caption"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
